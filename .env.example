STUDIO_API_TOKEN=replace-with-a-long-random-token
STUDIO_PUBLIC_ORIGIN=https://studio.example.com
STUDIO_SECURE_COOKIES=true

# Optional: Gemini key forwarded only to your private self-hosted OpenShorts API.
# Leave blank if OpenShorts is configured with a local OpenAI-compatible LLM.
OPENSHORTS_GEMINI_API_KEY=
# OpenShorts private API URL; set only when OpenShorts is running on a private network.
OPENSHORTS_API_URL=
OPENSHORTS_API_KEY=
OPENSHORTS_ALLOW_HOSTED=false
